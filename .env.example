APP_NAME=PokerHandsConverter
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pokercoinverter
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@pokerhandsconverter.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where the public /contact form is delivered (defaults to MAIL_FROM_ADDRESS's inbox).
CONTACT_EMAIL="info@pokerhandsconverter.com"

# "Log in with Google" — create an OAuth client at https://console.cloud.google.com/apis/credentials
# (Web application type) and add ${APP_URL}/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Stripe / Cashier ---
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- PokerCoinverter plan display / trial ---
PLAN_MONTHLY_AMOUNT=9
PLAN_YEARLY_AMOUNT=90
PLAN_CURRENCY=USD
PLAN_TRIAL_DAYS=7

# --- Converter tuning (see config/pokercoinverter.php) ---
CONVERTER_ROOM_NAME=CoinPoker
CONVERTER_CURRENCY_SYMBOL=$
CONVERTER_CURRENCY_CODE=USD
CONVERTER_TIMEZONE_MODE=dual
CONVERTER_ET_LABEL=ET
CONVERTER_FALLBACK_ET_OFFSET_HOURS=6
CONVERTER_RUN_IT_TWICE_MODE=keep
CONVERTER_MAX_UPLOAD_KB=20480

# --- Blog publishing API (leave BLOG_API_TOKEN empty to disable it) ---
# Server: set a long random token. Client (dev machine): also set BLOG_API_URL.
BLOG_API_TOKEN=
BLOG_API_URL=

# --- IndexNow (public key served at /<key>.txt; only active when APP_ENV=production) ---
INDEXNOW_KEY=

# --- Baidu (optional): verification meta tag + URL push API from ziyuan.baidu.com ---
BAIDU_SITE_VERIFICATION=
BAIDU_PUSH_TOKEN=
BAIDU_PUSH_SITE=
